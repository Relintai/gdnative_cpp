#!/usr/bin/env python

# Ue this if you want to filter generated binds:

bindings_filter_classes = True
bindings_class_list = "Object,Node,Node2D,Sprite,CanvasItem,Reference,GlobalConstants,OS,InputEvent,Font,Texture,AESContext,Resource,Image,InputEventKey,Material,Mesh,Shape,MultiMesh,InputEventWithModifiers,TriangleMesh,ArrayMesh,MultiplayerAPI,NetworkedMultiplayerPeer,ProcessGroup,PacketPeer,StyleBox,World2D,Physics2DDirectSpaceState,SceneTree,MainLoop,PackedScene,SceneTreeTween,SceneState,CallbackTweener,Physics2DShapeQueryParameters,SceneTreeTimer,Tweener,Viewport,IntervalTweener,World,MethodTweener,Camera2D,Control,PropertyTweener,Shader,ViewportTexture,Camera,Spatial,SpatialGizmo,World3D,Environment3D,Sky,PhysicsDirectSpaceState,PhysicsShapeQueryParameters,Theme,_OS"

env = SConscript("../SConstruct", exports={"bindings_filter_classes":bindings_filter_classes, "bindings_class_list":bindings_class_list})

# Or use this, if you want all binds:
#env = SConscript("../SConstruct")

# tweak this if you want to use different folders, or more folders, to store your source code in.
env.Append(CPPPATH=['src/'])
sources = Glob('src/*.cpp')

library = env.SharedLibrary(
    "bin/libgdexample.{}.{}.{}{}".format(
        env["platform"], env["target"], env["arch_suffix"], env["SHLIBSUFFIX"]
    ),
    source=sources,
)

Default(library)
